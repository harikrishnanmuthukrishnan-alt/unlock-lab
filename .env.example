# Create a NEW Supabase project for UNLOCK Lab. Never use another application's database.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Required in production. 1+ random secure value; never expose this value in frontend code.
COOKIE_SECURE=true
PORT=3000
# Optional: non-privileged single site origin for CSRF origin checks
PUBLIC_URL=https://your-production-domain.onrender.com
